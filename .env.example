# Port / interface the server listens on (0.0.0.0 = reachable from your LAN)
PORT=3000
HOST=0.0.0.0
# Public base URL encoded in the pairing QR code. Leave empty in local dev:
# the server then uses this machine's LAN IP so your phone can reach it.
PUBLIC_URL=
# SQLite file (":memory:" for a throw-away database)
DB_PATH=./data/sendlink.db
# Set to 1 when running behind a reverse proxy (Caddy/Nginx) that sets X-Forwarded-For
TRUST_PROXY=0
# Pairing token lifetime in seconds
PAIRING_TTL_SECONDS=120
NODE_ENV=development
